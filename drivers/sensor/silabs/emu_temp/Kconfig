config SILABS_EMU_TEMP
	bool "Silicon Labs Series 2 EMU temperature sensor"
	default y
	depends on DT_HAS_SILABS_EMU_TEMP_ENABLED
	select SILABS_SISDK_EMU
	help
	  Enable the internal die temperature sensor of the EMU on Silicon Labs
	  Series 2 (EFR32/EFM32) devices, read via EMU_TemperatureGet().
